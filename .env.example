# Copy this file to .env and fill in your own values.
# .env is gitignored. Never commit real credentials.

# MQTT broker. A free HiveMQ Cloud instance works, or a local Mosquitto.
# HiveMQ Cloud uses TLS on 8883; a local Mosquitto usually uses 1883 with no auth.
MQTT_HOST=your-instance.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=
MQTT_PASS=

# Station this simulator instance represents.
STATION_ID=STATION-01
