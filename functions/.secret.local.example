# Secrets for the Firebase Local Emulator Suite.
#
# Copy this file to `.secret.local` in the same directory. That file is
# gitignored, because a signing key in a repository is not a signing key.
#
# The emulator reads `defineSecret('SCLS_SIGNING_KEY')` from here. A deployed
# build would read the same name from Google Secret Manager instead, which is
# the only difference between the two.
#
# Any string works for a demonstration. It has to be the same string for the
# whole run, because a token signed with one key and checked against another is
# indistinguishable from a forged one.
SCLS_SIGNING_KEY=local-emulator-signing-key-not-for-real-use
